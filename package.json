{
  "name": "toml-format",
  "displayName": "TOML Formatter",
  "description": "TOML formatter and linter using taplo",
  "version": "0.1.0",
  "publisher": "fllesser",
  "author": {
    "name": "fllesser",
    "email": "fllessive@gmail.com"
  },
  "icon": "images/icon.png",
  "repository": "https://github.com/les-vsc-ext/toml-format",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Formatters"
  ],
  "activationEvents": [
    "onLanguage:toml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "toml",
        "aliases": [
          "TOML",
          "toml"
        ],
        "extensions": [
          ".toml"
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "code-install": "npm run compile && npx vsce package --out toml-format.vsix && code --install-extension toml-format.vsix",
    "ant-install": "npm run compile && npx vsce package --out toml-format.vsix && Antigravity --install-extension toml-format.vsix"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "^24.1.0",
    "typescript": "^5.1.3"
  }
}
